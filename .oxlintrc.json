{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "warn",
    "perf": "warn",
    "style": "warn"
  },
  "ignorePatterns": ["dist/", "bin/", "node_modules/"],
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "plugins": ["vitest"]
    }
  ]
}
