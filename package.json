{
  "name": "action-bark",
  "version": "2.4.0",
  "type": "module",
  "private": true,
  "description": "Push iOS notifications via Bark",
  "main": "bin/index.js",
  "scripts": {
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "oxlint",
    "package": "rolldown --config rolldown.config.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "all": "npm run format && npm run lint && npm run typecheck && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harryzcy/action-bark.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "axios": "1.21.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "24.0.1",
    "@types/node": "26.6.6",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "rolldown": "1.2.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
